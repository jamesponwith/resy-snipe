# Copy to .env and fill in real values:
#   cp .env.example .env
#
# The app reads these from the environment at startup (config/resy-config.go).
# It does NOT load .env itself, so export them into your shell first:
#   set -a && source .env && set +a

# --- Resy credentials (required) ---
# RESY_AUTH_TOKEN is a JWT and expires every few months. Refresh it from
# resy.com -> DevTools -> Network -> any api.resy.com call -> x-resy-auth-token.
RESY_API_KEY=""
RESY_AUTH_TOKEN=""

# --- Email alerts (optional) ---
# Leave ALERT_EMAIL_TO empty to disable email; terminal and log alerts still work.
# For Gmail, SMTP_PASS must be an App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), NOT your account password.
ALERT_EMAIL_TO=""
SMTP_USER=""
SMTP_PASS=""

# Defaults suit Gmail; override for another provider.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# Defaults to SMTP_USER when empty.
ALERT_EMAIL_FROM=""
